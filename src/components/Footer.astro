---
---

<footer class="foot">
  <div class="foot-dark" aria-hidden="true"></div>
  <div class="foot-pattern" aria-hidden="true"></div>
  <div class="foot-inner">

    <div class="foot-top">
      <div class="foot-brand">
        <a class="foot-mark" href="/" aria-label="Gustoso">
          <img src="/assets/logo-footer.svg" alt="Gustoso" />
        </a>
        <p>Distributore di prodotti enogastronomici di alta qualità con sede in Lombardia. Vini, champagne, gin personalizzato e fine food, selezionati accuratamente.</p>
      </div>

      <div class="foot-col">
        <button class="foot-acc-btn" type="button" aria-expanded="false" aria-controls="foot-cat">
          Selezione <span class="foot-acc-icon">+</span>
        </button>
        <ul class="foot-acc-body" id="foot-cat">
          <li><a href="#vini-overlay" data-open-vini>Vini e Champagne</a></li>
          <li><a href="/gin">Gin Personalizzato</a></li>
          <li><a href="/fine-food">Fine Food</a></li>
          <li><a href="#waitlist" data-open-waitlist>Prodotti Personalizzati</a></li>
        </ul>
      </div>

      <div class="foot-col">
        <button class="foot-acc-btn" type="button" aria-expanded="false" aria-controls="foot-co">
          Azienda <span class="foot-acc-icon">+</span>
        </button>
        <ul class="foot-acc-body" id="foot-co">
          <li><a href="/chi-siamo">Chi siamo</a></li>
          <li><a href="/b2b">B2B / HoReCa</a></li>
          <li><a href="/contatti">Contatti</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>&copy; MMXXVI Gustoso S.r.l. &middot; P. IVA [NUMERO]</span>
      <div class="legal">
        <a href="#">Privacy</a>
        <a href="#">Cookie</a>
        <a href="#">Termini</a>
      </div>
    </div>

  </div>
</footer>
