---
---

<div class="vini-overlay" id="vini-overlay" aria-hidden="true" role="dialog" aria-label="Vini e Champagne — le maison">
  <div class="vini-bg" aria-hidden="true"></div>
  <div class="vini-frame">
    <div class="vini-inner">

      <div class="vini-top">
        <div>
          <div class="eyebrow">Cantina</div>
          <h2 class="vini-h1">Le nostre <em>Maisons</em></h2>
        </div>
        <button class="vini-close" id="vini-close" aria-label="Chiudi"></button>
      </div>

      <div class="vini-grid">
        <a class="vcard" href="/catalogo-aubert-mathieu" data-maison="aubert">
          <div class="vcard-art" style="background-image:url('/assets/maison/aubert.jpg');"></div>
          <div class="vcard-scrim"></div>
          <div class="vcard-top"><span class="vcard-n">N&deg;01</span><span class="vcard-tag">Linguadoca</span></div>
          <div class="vcard-body">
            <div class="vcard-region">Sud de la France &middot; IGP</div>
            <h3 class="vcard-name">Aubert &amp; Mathieu</h3>
            <p class="vcard-desc">Vigneron contemporanei. Etichette d&rsquo;autore, vinificazioni nette, eleganza mediterranea.</p>
            <span class="vcard-cta">Scopri la maison <span class="arrow">&rarr;</span></span>
          </div>
        </a>
        <a class="vcard" href="/catalogo-marcoult" data-maison="marcoult">
          <div class="vcard-art" style="background-image:url('/assets/maison/marcoult.jpg');"></div>
          <div class="vcard-scrim"></div>
          <div class="vcard-top"><span class="vcard-n">N&deg;02</span><span class="vcard-tag">Champagne</span></div>
          <div class="vcard-body">
            <div class="vcard-region">S&eacute;zannais &middot; AOC</div>
            <h3 class="vcard-name">M. Marcoult</h3>
            <p class="vcard-desc">Champagne di famiglia, dosaggi misurati, una mano discreta che lascia parlare il terroir.</p>
            <span class="vcard-cta">Scopri la maison <span class="arrow">&rarr;</span></span>
          </div>
        </a>
        <a class="vcard" href="/catalogo-baron-fuente" data-maison="baron">
          <div class="vcard-art" style="background-image:url('/assets/maison/baron.jpg');"></div>
          <div class="vcard-scrim"></div>
          <div class="vcard-top"><span class="vcard-n">N&deg;03</span><span class="vcard-tag">Champagne</span></div>
          <div class="vcard-body">
            <div class="vcard-region">Charly-sur-Marne &middot; AOC</div>
            <h3 class="vcard-name">Baron Fuenté</h3>
            <p class="vcard-desc">Maison storica della Vallée. Pinot Meunier protagonista, cuvée di carattere.</p>
            <span class="vcard-cta">Scopri la maison <span class="arrow">&rarr;</span></span>
          </div>
        </a>
        <a class="vcard" href="/catalogo-odyssee" data-maison="odyssee">
          <div class="vcard-art" style="background-image:url('/assets/maison/odyssee.jpg');"></div>
          <div class="vcard-scrim"></div>
          <div class="vcard-top"><span class="vcard-n">N&deg;04</span><span class="vcard-tag">Champagne</span></div>
          <div class="vcard-body">
            <div class="vcard-region">Avize &middot; AOC</div>
            <h3 class="vcard-name">Champagne Odyssée</h3>
            <p class="vcard-desc">Una visione contemporanea della Champagne. Lavorazioni precise, profili minerali.</p>
            <span class="vcard-cta">Scopri la maison <span class="arrow">&rarr;</span></span>
          </div>
        </a>
        <a class="vcard" href="/catalogo-dumangin" data-maison="dumangin">
          <div class="vcard-art" style="background-image:url('/assets/maison/dumangin.jpg');"></div>
          <div class="vcard-scrim"></div>
          <div class="vcard-top"><span class="vcard-n">N&deg;05</span><span class="vcard-tag">Champagne</span></div>
          <div class="vcard-body">
            <div class="vcard-region">Chigny-les-Roses &middot; AOC</div>
            <h3 class="vcard-name">Dumangin</h3>
            <p class="vcard-desc">Récoltant-manipulant indipendente. Edizioni singole, tirature limitate, una firma riconoscibile.</p>
            <span class="vcard-cta">Scopri la maison <span class="arrow">&rarr;</span></span>
          </div>
        </a>
        <a class="vcard" href="/catalogo-boyer-de-bar" data-maison="boyer">
          <div class="vcard-art" style="background-image:url('/assets/maison/boyer-de-bar.jpg');"></div>
          <div class="vcard-scrim"></div>
          <div class="vcard-top"><span class="vcard-n">N&deg;06</span><span class="vcard-tag">Languedoc</span></div>
          <div class="vcard-body">
            <div class="vcard-region">Vallée de l&rsquo;Hérault &middot; IGP</div>
            <h3 class="vcard-name">Boyer-De Bar</h3>
            <p class="vcard-desc">Pinot Noir della Côte des Bar. Cuvée vibranti, ossatura solida, lunga persistenza.</p>
            <span class="vcard-cta">Scopri la maison <span class="arrow">&rarr;</span></span>
          </div>
        </a>
      </div>

      <div class="vini-foot">
        <span><kbd>Esc</kbd><span class="esc">per chiudere</span></span>
      </div>

    </div>
  </div>
</div>
