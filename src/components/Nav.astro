---
interface Props {
  tone?: 'dark' | '';
}
const { tone = '' } = Astro.props;
---

<nav class="nav" id="nav" data-tone={tone || undefined}>
  <div class="nav-inner">
    <button class="nav-burger" id="nav-burger" aria-label="Apri menu" aria-expanded="false" aria-controls="menu-overlay">
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>
    <a class="brand" href="/" aria-label="Gustoso">
      <img class="logo-light" src="/assets/logo-chiaro.svg" alt="Gustoso" />
    </a>
    <div class="nav-end">
      <button class="nav-search" id="nav-search" type="button" aria-label="Cerca">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
      <a class="nav-cta" href="/contatti" aria-label="Contattaci">
        <svg class="nav-cta-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <polyline points="3 7 12 13 21 7"></polyline>
        </svg>
        <span class="label-long">Contattaci</span>
      </a>
    </div>
  </div>
</nav>
