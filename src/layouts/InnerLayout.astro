---
import Nav from '../components/Nav.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import Footer from '../components/Footer.astro';
import ViniOverlay from '../components/ViniOverlay.astro';
import WaitlistModal from '../components/WaitlistModal.astro';

interface Props {
  title: string;
  description: string;
  page?: string;
  navTone?: 'dark' | '';
  ogImage?: string;
}

const { title, description, page = '', navTone = 'dark', ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site!).href;
const ogImg = ogImage ?? new URL('/assets/og-default.jpg', Astro.site!).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Gustoso",
  "url": "https://gustososhop.it",
  "logo": "https://gustososhop.it/assets/logo-footer.svg",
  "sameAs": []
});
---

<!doctype html>
<html lang="it">
<head>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QHMX24V6E2"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-QHMX24V6E2');
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Gustoso" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImg} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImg} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1a1614" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/site.css" />
  <link rel="stylesheet" href="/assets/inner.css" />
  <link rel="stylesheet" href="/assets/loaders.css" />
  <slot name="head" />
  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body data-page={page || undefined}>

  <Nav tone={navTone} />
  <MenuOverlay />

  <main>
    <slot />
  </main>

  <Footer />
  <ViniOverlay />
  <WaitlistModal />

  <script>import '../scripts/search';</script>
  <script is:inline src="/assets/loading-screen.js" defer></script>
  <slot name="scripts" />
  <script is:inline src="/assets/page.js"></script>

</body>
</html>
