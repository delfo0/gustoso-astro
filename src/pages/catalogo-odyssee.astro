---
import CatalogLayout from '../layouts/CatalogLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { sanityClient } from '../sanity/client';
import { mapProduct, PRODUCT_FIELDS } from '../sanity/mappers';

const [raw, maison] = await Promise.all([
  sanityClient.fetch(`*[_type == "product" && maison->slug.current == "odyssee"] | order(sortOrder asc) { ${PRODUCT_FIELDS} }`),
  sanityClient.fetch(`*[_type == "maison" && slug.current == "odyssee"][0] { "logoUrl": logoImage.asset->url, intro }`),
]);
const products = raw.map(mapProduct);
const logoSrc = maison?.logoUrl ?? '/assets/partners/odyssee.png';
---

<CatalogLayout
  title="Champagne Odyssée - Gustoso"
  description="Il catalogo completo di Champagne Odyssée: visione contemporanea della Champagne, lavorazioni precise, profili minerali. Selezionati da Gustoso."
  brandmarkSrc={logoSrc}
  brandmarkAlt="Champagne Odyssée"
>
  {products.map((p) => <ProductCard product={p} />)}
</CatalogLayout>
