---
import CatalogLayout from '../layouts/CatalogLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { sanityClient } from '../sanity/client';
import { mapProduct, PRODUCT_FIELDS } from '../sanity/mappers';

const [raw, maison] = await Promise.all([
  sanityClient.fetch(`*[_type == "product" && maison->slug.current == "dumangin"] | order(sortOrder asc) { ${PRODUCT_FIELDS} }`),
  sanityClient.fetch(`*[_type == "maison" && slug.current == "dumangin"][0] { "logoUrl": logoImage.asset->url, intro }`),
]);
const products = raw.map(mapProduct);
const logoSrc = maison?.logoUrl ?? '/assets/partners/dumangin.svg';
---

<CatalogLayout
  title="Dumangin - Gustoso"
  description="Il catalogo completo di Dumangin: récoltant-manipulant indipendente, edizioni singole, tirature limitate. Selezionati da Gustoso."
  brandmarkSrc={logoSrc}
  brandmarkAlt="Dumangin"
>
  {products.map((p) => <ProductCard product={p} />)}
</CatalogLayout>
