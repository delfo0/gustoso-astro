---
import CatalogLayout from '../layouts/CatalogLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { sanityClient } from '../sanity/client';
import { mapProduct, PRODUCT_FIELDS } from '../sanity/mappers';

const [raw, maison] = await Promise.all([
  sanityClient.fetch(`*[_type == "product" && category == "gin"] | order(sortOrder asc) { ${PRODUCT_FIELDS} }`),
  sanityClient.fetch(`*[_type == "maison" && slug.current == "gustoso-gin"][0] { "logoUrl": logoImage.asset->url }`),
]);
const products = raw.map(mapProduct);
const logoSrc = maison?.logoUrl;
---

<CatalogLayout
  title="Gin personalizzato - Gustoso"
  description="Tutti i formati e le ricette disponibili per il gin personalizzato Gustoso: 70cl · 43% vol · 15 botaniche · etichetta su misura."
  brandmarkSrc={logoSrc}
  brandmarkAlt="Gustoso Gin"
>
  <style slot="head">
    .cat-list { grid-template-columns: repeat(2, 1fr) !important; }
    .cat-product-name { max-width: none; -webkit-line-clamp: unset; }
    .cat-product-img { background-position: center center; }
    @media (max-width: 600px) { .cat-list { grid-template-columns: 1fr !important; } }
  </style>
  {products.map((p) => <ProductCard product={p} />)}
</CatalogLayout>
